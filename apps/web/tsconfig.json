{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@agrayian/types": ["../../packages/types/src/index.ts"],
      "@agrayian/sdk": ["../../packages/sdk/src/index.ts"],
      "@agrayian/ui": ["../../packages/ui/src/index.ts"]
    },
    "allowJs": false,
    "incremental": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
